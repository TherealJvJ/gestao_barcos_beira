# Configurações do Sistema de Gestão de Barcos - INTRANSMAR
# Copie este ficheiro para .env e preencha com os valores reais

SECRET_KEY=gere-uma-chave-secreta-segura-aqui
DEBUG=True

# PostgreSQL
DB_NAME=gestao_barcos_beira
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgres
DB_HOST=localhost
DB_PORT=5432

# MozeSMS - SMS para Moçambique (+258)
# Obtenha em: https://my.mozesms.com
MOZESMS_API_KEY=sua_api_key_mozesms
MOZESMS_API_SECRET=sua_api_secret_mozesms
MOZESMS_SENDER_ID=INTRANSMAR

# Gmail SMTP - Envio de E-mails
# Gere um App Password em: Conta Google > Segurança > Passwords de Apps
EMAIL_HOST_USER=seu_email@gmail.com
EMAIL_HOST_PASSWORD=senha_de_app_16_caracteres
